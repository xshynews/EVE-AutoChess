## 把一行原始数组转成带列名的 Dictionary
static func row_to_dict(row: Array) -> Dictionary:
	var d := {}
	for i in COLUMNS.size():
		d[COLUMNS[i]] = row[i] if i < row.size() else null
	return d


## 全部行 → Dictionary 数组（每次调用新建，调用方可以随便改）
static func rows_as_dicts() -> Array[Dictionary]:
	var out: Array[Dictionary] = []
	for row in ROWS:
		out.append(row_to_dict(row))
	return out


## 按 id 取原始行（未派生）。找不到返回 {}
static func find_row(ship_id: String) -> Dictionary:
	for row in ROWS:
		if row[0] == ship_id:
			return row_to_dict(row)
	return {}


## 表自检 —— 返回问题列表，空数组表示数据健康。
##
## 会在 eve_ship_database 的 _static_init 里自动跑一遍，
## 设计侧改完数值如果漏了某一列 / 写了个不存在的派系，启动就能看见。
static func validate() -> PackedStringArray:
	var problems: PackedStringArray = []
	var seen := {}
	for i in ROWS.size():
		var row: Array = ROWS[i]
		var tag := "第 %d 行" % (i + 1)
		if row.size() != COLUMNS.size():
			problems.append("%s 列数 %d ≠ %d" % [tag, row.size(), COLUMNS.size()])
			continue
		var id := String(row[0])
		if seen.has(id):
			problems.append("%s id 重复：%s" % [tag, id])
		seen[id] = true
		if not FACTION_INDEX.has(String(row[2])):
			problems.append("%s 未知势力：%s" % [tag, row[2]])
		# ★ 2026-10-10（审查 2#5）：武器/防御/定位的白名单**由 `EveCombatIds` 统一持有**
		#   —— 原来这里又硬编码了一份中文列表，和 id 映射表两处必然分叉。
		for u in CIDS.unknown_values_of_row(row):
			problems.append("%s 未知%s" % [tag, u])
		if int(row[5]) < 1 or int(row[5]) > 5:
			problems.append("%s 费用越界：%s" % [tag, row[5]])
	return problems
