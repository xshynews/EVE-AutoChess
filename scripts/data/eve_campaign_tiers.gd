## ⚠️ 2026-10-25：原来这里还有一张 `ROWS`（守卫边境 / 舰队集结 / 无边战火
##   三关），主界面「任务关卡」按它铺卡片。问题：那三张卡只是**占位**，
##   真正能进的是上面四档难度 ⇒ 主界面点了「守卫边境」永远进简单档，
##   困难/炼狱打不开。现在卡片直接由 `DIFFICULTIES` 生成（四张，全开放），
##   `ROWS` 整个删除 —— ⛔ 别再加回一份「关卡表」，那就是第二真相源。


## 按 id 取一条难度；找不到返回空字典（调用方自己判空）
static func find(id: String) -> Dictionary:
	for r in DIFFICULTIES:
		if String(r["id"]) == id:
			return r
	return {}


## 默认选中项 = 第一条已开放的难度（没有则第 0 条）
static func default_index() -> int:
	for i in DIFFICULTIES.size():
		if bool(DIFFICULTIES[i]["open"]):
			return i
	return 0


## 已开放的难度条数（主界面「可玩内容有多少」的口径）
static func open_count() -> int:
	var n := 0
	for r in DIFFICULTIES:
		if bool(r["open"]):
			n += 1
	return n


## 全部难度档（UI / 探针统一从这里取，⛔ 别在别处复制一份）
static func difficulties() -> Array:
	return DIFFICULTIES


## 按 id 取一档难度；找不到退回「简单」（⛔ 不要返回空字典，
## 否则每一处调用都要再判空一次，迟早有人漏判）。
static func difficulty(id: String) -> Dictionary:
	for d in DIFFICULTIES:
		if String(d["id"]) == id:
			return d
	return DIFFICULTIES[0]


## 难度名（日志 / 顶条用）
static func difficulty_name(id: String) -> String:
	return String(difficulty(id).get("name", "简单"))
