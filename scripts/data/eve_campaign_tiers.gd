extends RefCounted
class_name EveCampaignTiers

## EVE 自走棋 —— 任务关卡的【难度分级表】（唯一真相源）
##
## ══════════════════════════════════════════════════════════════════
##  为什么单独一张表
## ══════════════════════════════════════════════════════════════════
##  主界面右侧「一难一条」的竖长条全部由本表渲染。
##  **加难度 = 加一条记录**，界面自动多一条、位置自动排，不用改 UI 代码。
##  ⛔ 禁止在 UI 文件里写死难度名 / 回合数。
##
## ── 字段 ──────────────────────────────────────────────────────────
##   id      内部标识（存档与解锁判定用）
##   name    对外名（玩家看到的）
##   code    代号行（英文 + 第 N 难度）
##   rounds  回合数；0 = 待定
##   desc    一段描述
##   unlock  解锁条件文案（空串 = 默认开放）
##   stats   键值行 [[键, 值, 颜色档], ...]；颜色档 "" = 常规、"gold" = 星币色
##   open    是否已可进入（false = 界面整条压暗 + 按钮写「待开发」）
##
## ── 命名口径（2026-09-30 定案）────────────────────────────────────
##  对外一律用**具体名**（守卫边境 / 舰队集结 / 无边战火），
##  ⛔ 不用 PVE / PVP 做名字或 id —— 那两个是「对手是谁」的分类标签，
##     而**无尽模式也属于 PVE** ⇒ 拿 `pve` 当 id 会一对多，无法唯一指向本模式。
##
## ── 现状 ──────────────────────────────────────────────────────────
##  只有第 1 难度可进入；第 2 / 3 是「待开发」占位。
##  做好之后 = 把 open 改 true、补上 rounds 和 desc，界面一行都不用动。

const ROWS: Array = [
	{
		"id": "guard_border",
		"name": "守卫边境",
		"code": "GUARD THE BORDER · 第 1 难度",
		"rounds": 15,
		"desc": "第一难度。边境线上连续 15 个回合的遭遇战，敌人从游荡的海盗"
				+ "逐步升级为正规舰队。打完第 15 回合即通关，通关后解锁第二难度。",
		"unlock": "",
		"stats": [
			["对手", "电脑舰队 · 4 派系", ""],
			["回合数", "15 回合", ""],
			["解锁", "默认开放", "gold"],
			["状态", "可进入", ""],
		],
		"open": true,
	},
	{
		"id": "fleet_assembly",
		"name": "舰队集结",
		"code": "FLEET ASSEMBLY · 第 2 难度",
		"rounds": 25,
		"desc": "第二难度。25 个回合，敌人以成建制的舰队推进，规模与强度都比"
				+ "第一难度高一档。需先通关第一难度才解锁，目前尚未开发。",
		"unlock": "通关第 1 难度",
		"stats": [
			["对手", "电脑舰队 · 成建制", ""],
			["回合数", "25 回合", ""],
			["解锁", "通关第 1 难度", ""],
			["状态", "待开发", ""],
		],
		"open": false,
	},
	{
		"id": "endless_war",
		"name": "无边战火",
		"code": "ENDLESS WAR · 第 3 难度",
		"rounds": 0,
		"desc": "第三难度。规模与强度再上一档，回合配置待定。"
				+ "需先通关第二难度才解锁，目前尚未开发。",
		"unlock": "通关第 2 难度",
		"stats": [
			["对手", "待定", ""],
			["回合数", "待定", ""],
			["解锁", "通关第 2 难度", ""],
			["状态", "待开发", ""],
		],
		"open": false,
	},
]


## 按 id 取一条；找不到返回空字典（调用方自己判空）
static func find(id: String) -> Dictionary:
	for r in ROWS:
		if String(r["id"]) == id:
			return r
	return {}


## 默认选中项 = 第一条已开放的难度（没有则第 0 条）
static func default_index() -> int:
	for i in ROWS.size():
		if bool(ROWS[i]["open"]):
			return i
	return 0


## 已开放的难度条数（主界面「可玩内容有多少」的口径）
static func open_count() -> int:
	var n := 0
	for r in ROWS:
		if bool(r["open"]):
			n += 1
	return n
