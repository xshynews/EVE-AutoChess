// ═══════════════════════════════════════════════════════════════════════════
// EVE 舰船外壳 —— 材质分区 ramp（纯函数，无 uniform / 无纹理）
// ═══════════════════════════════════════════════════════════════════════════
//
// 为什么单独抽成 .gdshaderinc：
//   这段数学是「Blender ↔ Godot 一致」的唯一凭据，必须**只有一份**。
//   spatial 着色器（船体）与 canvas_item 探针（tools/probe_ship_material.gd）
//   都 include 它 —— 于是探针验证的就是线上真正跑的那段代码，
//   而不是"抄了一份看起来一样"的副本。
//
// 配方出处：`skills/eve-ship-3d-pipeline/scripts/blender_project.py`
//   金属度  ColorRamp(spec)  点位 0.28→0.00 / 0.42→0.03 / 0.58→0.45
//                                 0.68→0.80 / 0.78→0.95 / 1.00→0.97（LINEAR）
//   粗糙度  MapRange(Invert(spec), ToMin=0.62, ToMax=0.18)
//           ≡ clamp(0.18 + 0.44 * spec, 0.18, 0.62)
//
// ⚠️ 阈值可以直接用，不需要色彩空间换算 —— 这是**实测**的，不是推理：
//   探针把 `_s` 用「原始采样」和「source_color 采样」并排渲出来，
//   与一个已知常数色带（走同一条输出编码）比大小，
//   两条都是 0.6435 = 原始值 ⇒ Godot 把 `_s` 当线性数据读，没有 sRGB 解码。
//   如果这里按 sRGB 解了一次，0.682 会变成 0.415，
//   直接掉出 0.58~0.68 区间 ⇒ **金饰的金属度会从 0.95 塌到 0.45**，
//   屏幕上表现为"金饰像哑光涂料"，肉眼很难断言，所以必须量化过。
//
// ⚠️ 全库实测：四个派系的 `_s` 用的是**四套不同的值档**，而这条 ramp 是照艾玛
//   （0.345 白甲板 / 0.682 深色结构 / 0.780 金饰）量的：
//     艾玛    0.345 / 0.682 / 0.780  → 0.00 / 0.80 / 0.95   （准）
//     加达里  0.631 / 0.678 / 0.725  → 0.63 / 0.79 / 0.87
//     盖伦特  0.573 / 0.580 / 0.808  → 0.43 / 0.45 / 0.95
//     米玛塔尔 0.271 / 0.498 / 0.592 → 0.00 / 0.24 / 0.48
//   目前四派系共用一条 ramp（= 忠实复刻 Blender 的观感）。
//   要做「派系准确」，就给 EveShipMaterial 按派系传 spec_gain / spec_bias，
//   或在此加一组按派系的点位 —— 但那是**重新设计**，不是还原，需要有依据再做。

float eve_metal_ramp(float s) {
	if (s <= 0.28) {
		return 0.00;
	}
	if (s <= 0.42) {
		return mix(0.00, 0.03, (s - 0.28) / 0.14);
	}
	if (s <= 0.58) {
		return mix(0.03, 0.45, (s - 0.42) / 0.16);
	}
	if (s <= 0.68) {
		return mix(0.45, 0.80, (s - 0.58) / 0.10);
	}
	if (s <= 0.78) {
		return mix(0.80, 0.95, (s - 0.68) / 0.10);
	}
	if (s <= 1.00) {
		return mix(0.95, 0.97, (s - 0.78) / 0.22);
	}
	return 0.97;
}

// roughness = MapRange(Invert(spec)) 的闭式：ToMin=rw, ToMax=rg
//  输出 = rw + (1 - s) * (rg - rw) = rg + (rw - rg) * s
//  s ∈ [0,1] 时结果天然落在 [rg, rw]，clamp 只是护住异常输入。
//
// ⚠️ 形参名**不能**叫 r_white / r_gold —— `#include` 是文本内联到**全局作用域**，
//    而 ship_hull.gdshader 里正好有同名 uniform，会报 `Redefinition of 'r_white'`。
//    （报错只指到这里，看不出是跨文件撞名，踩过一次。）
float eve_roughness(float s, float rw, float rg) {
	return clamp(rg + (rw - rg) * s, rg, rw);
}
