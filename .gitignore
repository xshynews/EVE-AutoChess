# Godot 4+ specific ignores
.godot/

# Godot editor temp / backup files
*.tmp
project.godot*.tmp
*.bak
*.bak-*
*.bak.*
project.godot.bak*

# Local build & internal verification artifacts (not source)
# Android 构建模板（Godot「安装 Android 构建模板」生成；含两个 103MB AAR，207MB）
# ⛔ 只忽略 build/ 子目录；README.md / .build_version / .gdignore 要入库（见 android/README.md）
/android/build/
_验收/
# 真机抓图 / 出图产物（tools/android/device_shot.sh 默认写这里；不入库）
outputs/
_logs_backup_*/
QQ图片*

# OS / editor cruft
.DS_Store
Thumbs.db

# Python bytecode (export pipeline)
__pycache__/

# 流水线工作目录（中间产物）
.pipeline_work/

# 联机内核（第三方二进制，不入库；由 _fetch_easytier.py 获取）
/addons/easytier/bin/

# 卡牌原图默认目录（tools/pipeline/_paths.py 的 CARD_SRC）
.incoming/

# 发布包默认输出目录（tools/pipeline/_paths.py 的 EXPORT_DIR）
build/

# 流水线本机路径配置（模板见 tools/pipeline/paths.local.example.json）
tools/pipeline/paths.local.json

# 音效候选隔离区（2026-10-16 起）：未拍板、未授权复核完的素材，按「隔离区」语义不入库。
# 其中含 UNO 提取音（⛔ 不可商用），入库会把授权风险带进仓库。
# 授权文本与拍板流程见 docs/音效落地执行方案-1016.md。
assets/audio_candidates/


# DSH 工具链锁文件（harness 产物，非工程源码）
.dsh-ops-update-*.lock
**/.dsh-ops-update-*.lock

# Office 临时文件
~$*
